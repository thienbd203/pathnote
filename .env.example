APP_BIND=127.0.0.1:3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://pathnote:CHANGE_ME@127.0.0.1:5432/pathnote
RUST_LOG=server=debug,tower_http=info

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
# Chỉ false trên localhost. Production dùng HTTPS và true.
COOKIE_SECURE=false

# Khóa RSA riêng của Pathnote, không phải Google client secret.
JWT_PRIVATE_KEY_PATH=.keys/access-token.pem
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=pathnote-api
JWT_KEY_ID=pathnote-local-1

# Private storage outside any public web root; retain it across releases.
MEDIA_ROOT=.storage/media

# Optional: enable existing Hocuspocus server. Leave URL empty for HTTP autosave.
COLLABORATION_URL=
COLLABORATION_SECRET=

# Existing eSpeak and LibreTranslate services; keep empty to disable automatic lookups.
PRONUNCIATION_URL=
TRANSLATION_URL=
