# Replace the example hostname and certificate paths before installing this file.
server {
    listen 443 ssl;
    server_name rust-api.example.com;
    ssl_certificate /etc/letsencrypt/live/rust-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rust-api.example.com/privkey.pem;
    server_tokens off;
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        # Media is private and served by the Rust API, never directly from shared/media.
    }
}
