APP_BIND=127.0.0.1:3000
FRONTEND_URL=https://pathnote.aphorisms.cloud
DATABASE_URL=postgres://pathnote:CHANGE_ME@127.0.0.1:5432/pathnote_rust
RUST_LOG=server=info,tower_http=info

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URL=https://rust-api.example.com/api/v1/auth/google/callback
COOKIE_SECURE=true
JWT_PRIVATE_KEY_PATH=/opt/pathnote-rust/shared/keys/access-token.pem
JWT_ISSUER=https://rust-api.example.com
JWT_AUDIENCE=pathnote-api
JWT_KEY_ID=pathnote-production-1
MEDIA_ROOT=/opt/pathnote-rust/shared/media

COLLABORATION_URL=
COLLABORATION_SECRET=
PRONUNCIATION_URL=http://127.0.0.1:8020
TRANSLATION_URL=http://127.0.0.1:8022
